{
  "name": "@pulkitbhatia/bennycli",
  "version": "0.1.0",
  "description": "A coding agent for your terminal, with a hand-written agent loop. Runs on Groq's free tier.",
  "keywords": [
    "ai",
    "agent",
    "coding-agent",
    "cli",
    "llm",
    "groq",
    "terminal"
  ],
  "license": "MIT",
  "author": "Pulkit Bhatia",
  "homepage": "https://github.com/mepulkitbhatia/bennycli#readme",
  "bugs": "https://github.com/mepulkitbhatia/bennycli/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mepulkitbhatia/bennycli.git"
  },
  "type": "module",
  "bin": {
    "benny": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "test": "vitest run",
    "dev": "node --env-file=.env src/cli.ts",
    "spike": "node --env-file=.env scripts/spike.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "diff": "^9.0.0",
    "openai": "^7.28.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
